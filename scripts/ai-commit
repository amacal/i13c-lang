#!/bin/bash
# ai-commit :: Commit staged changes with a generated message
set -e

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    echo "Usage: ai-commit"
    echo ""
    echo "Commits everything currently staged, generating the commit message"
    echo "from the staged diff (read alongside the surrounding code for"
    echo "context)."
    exit 0
fi

if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Not a git repository." >&2
    exit 1
fi

DIFF=$(git diff --cached)

if [ -z "$DIFF" ]; then
    echo "Nothing staged, nothing to commit." >&2
    exit 1
fi

FILES=$(git diff --cached --name-only)

PROMPT=$(cat <<EOF
Write a git commit message for the staged changes below.
Before writing anything, read the surrounding code in the affected files (not
just the diff hunks) so you understand the real intent - the diff alone is
often misleading out of context.

Be concise, not verbose: a short imperative subject line (<=72 chars), and
only add a body (a couple of short bullet points) if the subject alone can't
carry the "why". No preamble, no markdown code fences, no restating the diff
line by line. Never mention "AI", "Claude", "LLM", "assistant", or any model/
vendor name, even when the change itself touches code that calls one -
describe what the code mechanically does instead (e.g. "generates X via a CLI
call"). Output just the commit message text, ready to pass straight to
'git commit -m'.

Changed files:
${FILES}

Staged diff:
${DIFF}
EOF
)

SCHEMA='{"type":"object","properties":{"message":{"type":"string","description":"The git commit message text only - no preamble, no meta-commentary about the writing process."}},"required":["message"]}'

MESSAGE=$(echo "$PROMPT" | claude -p --dangerously-skip-permissions --tools Read Grep Glob --permission-prompts none --no-session-persistence --output-format json --json-schema "$SCHEMA" | jq -r .structured_output.message)

if [ -z "$MESSAGE" ]; then
    echo "Failed to generate a commit message." >&2
    exit 1
fi

git commit -m "$MESSAGE"
