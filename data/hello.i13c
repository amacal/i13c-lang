asm exit(code@imm: u32[0x00000000..0x000000ff]) noreturn clobbers rdi, rcx, r11, rax {
    mov edi, @code;
    mov eax, 0x0000003c;
    syscall;
}

asm print(value@rax: u64) clobbers rax, rcx, r11, rdi, rsi, rdx {
    mov rcx, 0x3736353433323130;
    mov qword [rsp - 0x10], rcx;
    mov rcx, 0x6665646362613938;
    mov qword [rsp - 0x08], rcx;
    mov ecx, 0x00000010;
    mov esi, 0x0000000f;

  .nibble:
    mov r11, rax;
    and r11, rsi;

    mov r11b, byte [rsp + r11 - 0x10];
    mov byte [rsp + rcx - 0x30], r11b;
    shr rax, 0x04;

    loop @nibble;
    mov byte [rsp - 0x1f], 0x0a;

    mov edi, 0x00000001;
    lea rsi, [rsp - 0x2f];
    mov edx, 0x00000011;
    mov eax, 0x00000001;

    syscall;
    ret;
}

fn main() noreturn {
  print(0x0123456789abcdef);
  exit(0x00000000);
}
